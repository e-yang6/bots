+def shape_rescue(image, aorta_mask, baseline, fraction=SHAPE_RESCUE_FRACTION,
+                 response_fraction=SHAPE_RESPONSE_FRACTION):
+    from src.lumen_evidence import _multiscale_vesselness
+
+    hu = _as_array(image).astype(np.float32, copy=False)
+    mask = _as_array(aorta_mask).astype(bool)
+    spacing = image.GetSpacing()
+    reference = baseline["lumen_reference_hu"]
+    threshold = min(baseline["threshold_hu"], fraction * reference)
+    distance = ndimage.distance_transform_edt(~mask, sampling=np.asarray(spacing)[::-1])
+    region = distance <= baseline["budget_mm"]
+    normalized = sitk.GetImageFromArray(np.clip(hu / max(reference, 1.0), -0.2, 1.0))
+    normalized.CopyInformation(image)
+    response = sitk.GetArrayFromImage(_multiscale_vesselness(normalized, SHAPE_RESCUE_SIGMAS_MM))
+    outer = region & (distance > SLEEVE_MM) & (hu >= threshold)
+    values = response[outer & (response > 0)]
+    if values.size == 0:
+        return baseline
+    cutoff = float(np.percentile(values, 99)) * response_fraction
+    support = ndimage.binary_dilation(response >= cutoff, structure=_CROSS)
+    support |= distance <= SLEEVE_MM
+    ceiling = float(np.percentile(hu[mask], 99))
+    new_lumen = region & support & (hu >= threshold) & (hu <= ceiling)
+    protected = np.isfinite(baseline["dist"])
+    traversal = protected | new_lumen
+    source = baseline["dist"] == 0
+    dist, parent, frontier = _flood(traversal, source, mask, spacing, baseline["budget_mm"], region,
+                                   baseline["band_mm"])
+    leak = detect_leak(frontier, baseline["aorta_cross_section_voxels"], baseline["band_mm"],
+                       total_visited=int(frontier.sum()), aorta_voxels=int(mask.sum()))
+    added = np.isfinite(dist) & ~protected & (distance > SLEEVE_MM)
+    if leak["leak"] or not added.any():
+        return {**baseline, "shape_rescue_added_voxels": 0, "shape_rescue_leak": leak["leak"]}
+    attempt = {"fraction": threshold / reference, "threshold_hu": threshold, "leak": False,
+               "reason": "shape_rescue", "growth": leak["growth"], "visited": int(frontier.sum()),
+               "excised_voxels": 0}
+    return {**baseline, "dist": dist, "parent": parent, "frontier_sizes": frontier,
+            "traversal": traversal, "threshold_hu": threshold, "threshold_fraction": threshold / reference,
+            "leak": leak, "attempts": baseline["attempts"] + [attempt], "retries": baseline["retries"] + 1,
+            "shape_rescue_added_voxels": int(added.sum()), "shape_rescue_leak": False}
