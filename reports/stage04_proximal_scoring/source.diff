+        points = np.vstack([points[arc < max_length_mm], end])
+        arc = np.r_[0., np.cumsum(np.linalg.norm(np.diff(points, axis=0), axis=1))]
+    return {**trace, "points_mm": points, "arc_lengths_mm": arc, "traced_length_mm": float(arc[-1])}
